{
  "kind": "collectionType",
  "collectionName": "user_settings",
  "info": {
    "singularName": "user-setting",
    "pluralName": "user-settings",
    "displayName": "User settings"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "userSettings",
      "required": true
    },
    "ownerKey": {
      "type": "string",
      "maxLength": 64,
      "private": true,
      "unique": true,
      "required": true,
      "configurable": false
    },
    "language": {
      "type": "enumeration",
      "enum": ["pt-BR", "en-US"],
      "default": "pt-BR",
      "required": true
    },
    "themePrimaryColor": {
      "type": "string",
      "maxLength": 7,
      "minLength": 7,
      "default": "#111827",
      "required": true
    },
    "themeSecondaryColor": {
      "type": "string",
      "maxLength": 7,
      "minLength": 7,
      "default": "#f9fafb",
      "required": true
    },
    "activePreset": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::cube-preset.cube-preset"
    },
    "themeMode": {
      "type": "enumeration",
      "enum": ["dark", "light", "custom"],
      "default": "dark",
      "required": true
    },
    "themeSurfaceColor": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "default": "#242420",
      "required": true
    },
    "themeAccentColor": {
      "type": "string",
      "minLength": 7,
      "maxLength": 7,
      "default": "#d7fa19",
      "required": true
    },
    "keyboardBindings": {
      "type": "json"
    },
    "hintsEnabled": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
