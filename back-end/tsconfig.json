{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "strict": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": ["config/**/*.ts", "src/**/*.ts", "src/**/*.json", "types/**/*.ts"],
  "exclude": ["node_modules", "dist", "build", ".cache", ".tmp", "src/admin"]
}
