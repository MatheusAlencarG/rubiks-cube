{
  "name": "rubiks-cube",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/node": "^16.18.12",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "cubejs": "1.3.2",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-id-swiper": "^4.0.0",
    "react-router-dom": "^6.8.1",
    "react-scripts": "5.0.1",
    "swiper": "^9.2.0",
    "swr": "^2.5.1",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "develop": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "test:ci": "react-scripts test --watchAll=false --runInBand",
    "eject": "react-scripts eject",
    "preview": "node scripts/serve-build.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write",
    "lint": "eslint src tests playwright.config.ts --ext .ts,.tsx --max-warnings=0",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "lint:staged": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "prepare": "cd .. && husky .husky"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "prettier"
    ],
    "overrides": [
      {
        "files": [
          "src/**/*.{test,spec}.{js,jsx,ts,tsx}",
          "src/**/__tests__/**/*.{js,jsx,ts,tsx}"
        ],
        "extends": [
          "react-app/jest"
        ]
      }
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "eslint-config-prettier": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tailwindcss": "^3.4.17"
  }
}
